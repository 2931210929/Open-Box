#!/bin/sh
# 由 entrypoint 加载；V8 参数和 RSS 自检必须使用同一份环境设置。
# 堆上限默认按启动时的实际可用内存动态算（和 OpenWrt / Debian 同一套公式），不写死。
# 显式设置 OPENBOX_PANEL_HEAP_MB 时以显式值为准（单机覆盖）。
meminfo=${OPENBOX_MEMINFO_PATH:-/proc/meminfo}
mem_total_kb=$(awk '/^MemTotal:/ {print $2}' "$meminfo" 2>/dev/null)
mem_avail_kb=$(awk '/^MemAvailable:/ {print $2}' "$meminfo" 2>/dev/null)
[ -n "$mem_total_kb" ] || mem_total_kb=1048576
[ -n "$mem_avail_kb" ] || mem_avail_kb=$mem_total_kb
# /proc/meminfo reports the host, even when this container has a smaller limit.
# Clamp both the total and remaining memory to cgroup v2 or v1 before sizing V8.
cgroup_root=${OPENBOX_CGROUP_ROOT:-/sys/fs/cgroup}
cgroup_limit_kb=0
for cgroup_file in "$cgroup_root/memory.max" "$cgroup_root/memory/memory.limit_in_bytes" "$cgroup_root/memory.limit_in_bytes"; do
 [ -r "$cgroup_file" ] || continue
 limit_kb=$(awk -v total="$mem_total_kb" '$1 ~ /^[0-9]+$/ && $1 > 0 && $1 / 1024 < total {printf "%.0f", $1 / 1024}' "$cgroup_file")
 [ -n "$limit_kb" ] || continue
 mem_total_kb=$limit_kb
 cgroup_limit_kb=$limit_kb
 case "$cgroup_file" in
  */memory.max) usage_file="${cgroup_file%memory.max}memory.current" ;;
  *) usage_file="${cgroup_file%memory.limit_in_bytes}memory.usage_in_bytes" ;;
 esac
 usage_kb=0
 if [ -r "$usage_file" ]; then
  usage_kb=$(awk '$1 ~ /^[0-9]+$/ {printf "%.0f", $1 / 1024}' "$usage_file")
  [ -n "$usage_kb" ] || usage_kb=0
 fi
 remaining_kb=$((limit_kb - usage_kb))
 [ "$remaining_kb" -gt 0 ] || remaining_kb=0
 [ "$mem_avail_kb" -le "$remaining_kb" ] || mem_avail_kb=$remaining_kb
done
reserve_kb=$(( mem_total_kb / 8 ))
[ "$reserve_kb" -lt 196608 ] && reserve_kb=196608
floor_mb=$(( mem_total_kb / 1024 / 8 ))
[ "$floor_mb" -lt 64 ] && floor_mb=64
[ "$floor_mb" -gt 128 ] && floor_mb=128
ceiling_mb=$(( mem_total_kb / 1024 / 6 ))
[ "$ceiling_mb" -lt 128 ] && ceiling_mb=128
[ "$ceiling_mb" -gt 320 ] && ceiling_mb=320
auto_mb=$(( (mem_avail_kb - reserve_kb) / 1024 ))
[ "$auto_mb" -lt "$floor_mb" ] && auto_mb=$floor_mb
[ "$auto_mb" -gt "$ceiling_mb" ] && auto_mb=$ceiling_mb
export OPENBOX_PANEL_HEAP_MB="${OPENBOX_PANEL_HEAP_MB:-$auto_mb}"
case "$OPENBOX_PANEL_HEAP_MB" in
 *[!0-9]*|0*|'') echo 'OPENBOX_PANEL_HEAP_MB must be an integer from 64 to 4096' >&2; exit 1;;
esac
if [ "${#OPENBOX_PANEL_HEAP_MB}" -gt 4 ] || [ "$OPENBOX_PANEL_HEAP_MB" -lt 64 ] || [ "$OPENBOX_PANEL_HEAP_MB" -gt 4096 ]; then
 echo 'OPENBOX_PANEL_HEAP_MB must be an integer from 64 to 4096' >&2
 exit 1
fi
if [ "$cgroup_limit_kb" -gt 0 ] && [ "$((OPENBOX_PANEL_HEAP_MB + 64))" -gt "$((cgroup_limit_kb / 1024))" ]; then
 echo 'OPENBOX_PANEL_HEAP_MB plus 64 MiB of non-heap memory must fit the container memory limit' >&2
 exit 1
fi
if [ -n "${OPENBOX_PANEL_RSS_LIMIT_MB:-}" ]; then
 case "$OPENBOX_PANEL_RSS_LIMIT_MB" in
  *[!0-9]*|0*) echo 'Invalid OPENBOX_PANEL_RSS_LIMIT_MB' >&2; exit 1;;
 esac
 # 留出 Node 堆外空间，防止 RSS 上限比正常 V8 水位还低造成反复重启。
 if [ "${#OPENBOX_PANEL_RSS_LIMIT_MB}" -gt 5 ] || [ "$OPENBOX_PANEL_RSS_LIMIT_MB" -lt 120 ] || [ "$OPENBOX_PANEL_RSS_LIMIT_MB" -lt "$((OPENBOX_PANEL_HEAP_MB + 64))" ]; then
  echo 'OPENBOX_PANEL_RSS_LIMIT_MB must be at least 120 and at least heap + 64' >&2
  exit 1
 fi
 export OPENBOX_PANEL_RSS_LIMIT_MB
fi
